# 核心代码示例（可直接使用）
## 1. JWT 双Token工具类
```go
// internal/infra/jwt/jwt.go
package jwt

import (
	"errors"
	"github.com/golang-jwt/jwt/v4"
	"time"
)

var AccessSecret = []byte("im_chat_access_secret")
var RefreshSecret = []byte("im_chat_refresh_secret")

type Claims struct {
	UserID int64 `json:"user_id"`
	jwt.RegisteredClaims
}

// 生成短Token 30分钟
func GenerateAccessToken(userID int64) (string, error) {
	claims := Claims{
		UserID: userID,
		RegisteredClaims: jwt.RegisteredClaims{
			ExpiresAt: jwt.NewNumericDate(time.Now().Add(30 * time.Minute)),
		},
	}
	token := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)
	return token.SignedString(AccessSecret)
}

// 生成长Token 7天
func GenerateRefreshToken(userID int64) (string, error) {
	claims := Claims{
		UserID: userID,
		RegisteredClaims: jwt.RegisteredClaims{
			ExpiresAt: jwt.NewNumericDate(time.Now().Add(7 * 24 * time.Hour)),
		},
	}
	token := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)
	return token.SignedString(RefreshSecret)
}
```

## 2. Socket.IO 初始化
```go
// internal/interface/socket/socket.go
package socket

import (
	"github.com/gin-gonic/gin"
	socketio "github.com/googollee/go-socket.io"
	"net/http"
)

func NewSocketServer() *socketio.Server {
	server := socketio.NewServer(nil)

	// 用户连接
	server.OnConnect("/", func(s socketio.Conn) error {
		// 从Header获取Token解析UserID
		userID := s.Request().Header.Get("User-ID")
		s.SetContext(userID)
		// 加入个人房间（私聊用）
		server.JoinRoom("/", "user_"+userID, s)
		return nil
	})

	// 私聊事件
	server.OnEvent("/", "private_chat", func(s socketio.Conn, msg map[string]interface{}) {
		sendID := msg["send_id"].(float64)
		recvID := msg["recv_id"].(string)
		content := msg["content"].(string)
		
		// 推送至目标用户
		server.BroadcastToRoom("/", "user_"+recvID, "new_msg", map[string]interface{}{
			"send_id": sendID,
			"content": content,
			"type":    1,
		})
	})

	return server
}
```

## 3. Gin + Socket.IO 整合启动
```go
// cmd/main.go
package main

import (
	"github.com/gin-gonic/gin"
	"im-chat/internal/interface/socket"
	"net/http"
)

func main() {
	r := gin.Default()
	// 注册HTTP接口
	// ...

	// 注册Socket.IO
	socketServer := socket.NewSocketServer()
	r.GET("/socket.io/*any", gin.WrapH(socketServer))
	r.POST("/socket.io/*any", gin.WrapH(socketServer))

	// 启动
	_ = r.Run(":8080")
}
```

